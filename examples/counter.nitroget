<widget name="counter" width="320" height="210">
  <box class="card">
    <row class="line">
      <button class="btn" on:click="increment()">+1</button>
      <button class="btn ghost" on:click="reset()">reset</button>
      <spacer />
      <label class="count">{count}</label>
    </row>

    {#if count >= 10}
      <label class="warn">that is a lot of clicks</label>
    {/if}

    <row class="line volume">
      <label class="k">volume</label>
      <slider class="slider" value="{volume}" min="0" max="100" on:change="set_volume()" />
      <label class="v">{volume}</label>
    </row>

    <label class="hint">click, drag, edit the file to hot-reload</label>
  </box>
</widget>

<style>
  .card {
    background-color: rgba(18, 18, 24, 0.72);
    border-radius: 18px;
    padding: 16px 20px;
  }

  .line {
    margin-bottom: 10px;
  }

  .btn {
    background-color: #6366f1;
    color: white;
    border-radius: 9px;
    padding: 6px 14px;
    font-weight: 700;
    font-size: 13px;
  }

  .btn:hover {
    background-color: #818cf8;
  }

  .ghost {
    background-color: rgba(255, 255, 255, 0.08);
    color: #d4d4d8;
    margin-left: 8px;
  }

  .count {
    font-size: 34px;
    font-weight: 800;
    color: #f4f4f5;
  }

  .warn {
    color: #fbbf24;
    font-size: 12px;
    margin-bottom: 8px;
  }

  .k {
    font-size: 12px;
    color: #a1a1aa;
    font-weight: 700;
  }

  .v {
    font-size: 12px;
    color: #f4f4f5;
  }

  slider {
    margin: 0 10px;
  }

  slider trough {
    min-height: 6px;
    border-radius: 3px;
    background-image: none;
    background-color: rgba(255, 255, 255, 0.12);
  }

  slider highlight {
    min-height: 6px;
    border-radius: 3px;
    background-image: none;
    background-color: #6366f1;
  }

  slider slider {
    min-width: 14px;
    min-height: 14px;
    background-image: none;
    background-color: #f4f4f5;
    border-radius: 7px;
  }

  .hint {
    font-size: 11px;
    color: #52525b;
  }
</style>

<script>
  count = 0
  volume = 35

  function increment()
    count = count + 1
  end

  function reset()
    count = 0
  end

  function set_volume()
    volume = math.floor(event.value)
  end
</script>
